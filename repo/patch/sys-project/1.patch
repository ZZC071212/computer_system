+static char sbi_debug_console_read_byte(void) {
+  static const char scripted_input[] =
+      "help\n"
+      "pid\n"
+      "echo hello from xpart shell\n"
+      "tlb\n"
+      "exit\n";
+  static uint64_t pos = 0;
+
+  if (pos < sizeof(scripted_input) - 1) {
+    return scripted_input[pos++];
+  }
+  return uart_rx();
+}
+
+static unsigned long sbi_debug_console_read(unsigned long num_bytes, unsigned long base_addr_lo, unsigned long base_addr_hi) {
+  char *s = (char *)base_addr_lo;
+  unsigned long done = 0;
+  if (base_addr_hi != 0) {
+    return 0;
+  }
+
+  while (done < num_bytes) {
+    char c = sbi_debug_console_read_byte();
+    s[done++] = c;
+    if (c == '\n') {
+      break;
+    }
+  }
+  return done;
+}
